# =============================================================================
# wsl.config.psd1 - WSL provisioning choices (read by setup-wsl.ps1)
#
# Generated by `make setup` (scripts/setup-wizard.ps1); safe to edit by hand.
# true  = install / enable
# false = skip
# A missing key falls back to the default shown here.
# =============================================================================
@{
    Docker                 = $true   # Install Docker (native daemon, no Docker Desktop)?
    NvidiaContainerToolkit = $false  # Install NVIDIA Container Toolkit (GPU in containers; needs an NVIDIA GPU)?
    PostgreSQL             = $false  # Add PostgreSQL provider?
    PgAdmin                = $false  # Add pgAdmin provider?
    Redis                  = $true   # Add Redis provider?
    Portainer              = $true   # Add Portainer provider?
    MinIO                  = $false  # Add MinIO provider (manual start)?
    SeaweedFS              = $false  # Add SeaweedFS provider (manual start)?
    Python                 = $true   # Install Python tooling?
    Node                   = $true   # Install Node tooling?
    GitKraken              = $true   # Install GitKraken?
    KeyboardLayout         = $true   # Configure the keyboard layout (br / abnt2)?
}
