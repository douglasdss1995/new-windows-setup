# =============================================================================
# .gitconfig - Shared Git defaults (Windows + WSL), READ-ONLY by convention
#
# This file is NOT ~/.gitconfig. The setup scripts generate a real, untracked
# ~/.gitconfig on each machine whose first lines are:
#
#     [include]
#         path = <repo>/git/.gitconfig
#
# so `git config --global ...` writes to that local file and can never modify
# this tracked one. Machine/person-specific values therefore NEVER belong
# here - the tests fail if a user or credential section shows up in this
# file:
#   - user.name / user.email  -> set from windows.config.psd1 (Git block)
#   - credential.helper       -> resolved per machine (WSL: Windows GCM path)
# Local values override these defaults because the include comes first.
# =============================================================================

[core]
    autocrlf = input
    editor = code --wait
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    line-numbers = true
    side-by-side = false

[merge]
    conflictstyle = diff3
	ff = only

[diff]
    colorMoved = default

[pull]
	rebase = true

[rebase]
	autoStash = true

[push]
	default = current
    autoSetupRemote = true

[init]
    defaultBranch = main

[fetch]
    prune = true

[rerere]
    enabled = true

[help]
    autocorrect = 1

[commit]
    verbose = true

[alias]
    st = status -sb
    co = checkout
    br = branch
    lg = log --graph --oneline --decorate --all
	pushf = push --force-with-lease
