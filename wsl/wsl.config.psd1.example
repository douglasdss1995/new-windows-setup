# =============================================================================
# wsl.config.psd1 - WSL provisioning choices (read by setup-wsl.ps1)
#
# Generated by `make setup` (scripts/setup-wizard.ps1); safe to edit by hand.
# true  = install / enable
# false = skip
# A missing key falls back to the default shown here.
# =============================================================================
@{

    # Install Docker (native daemon, no Docker Desktop)?
    #   Installs the Docker engine inside WSL and enables it through systemd.
    #   Needs systemd=true in /etc/wsl.conf (already set by this repo).
    #   If you answer no, these are skipped too: NvidiaContainerToolkit, PostgreSQL, PgAdmin, Valkey, Portainer, MinIO, SeaweedFS, Ollama.
    Docker                 = $true

    # Install NVIDIA Container Toolkit (GPU in containers)?
    #   Lets containers use the GPU (docker run --gpus all).
    #   Needs an NVIDIA GPU and the regular NVIDIA driver installed on WINDOWS (with WSL support).
    #   Never install a Linux NVIDIA driver inside WSL; nvidia-smi must already work there.
    #   If no GPU is visible at install time the step is skipped with a warning.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    NvidiaContainerToolkit = $false

    # Add PostgreSQL provider?
    #   Container on localhost:5433, started with the other providers.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    #   If you answer no, these are skipped too: PgAdmin.
    PostgreSQL             = $false

    # Add pgAdmin provider?
    #   Web UI for PostgreSQL on http://localhost:5050.
    #   Requires: Docker + PostgreSQL set to yes (not asked, and forced to no, otherwise).
    PgAdmin                = $false

    # Add Valkey provider?
    #   Redis-compatible cache/queue container (BSD licence, replaces Redis) on localhost:6379.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    Valkey                 = $true

    # Add Portainer provider?
    #   Docker web UI on http://localhost:8001.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    Portainer              = $true

    # Add MinIO provider (manual start)?
    #   S3-compatible storage on :9000 (console :9001); discontinued upstream.
    #   Never starts with the machine: docker compose --profile minio up -d minio.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    MinIO                  = $false

    # Add SeaweedFS provider (manual start)?
    #   S3-compatible storage on :8333 (filer :8888, master :9333); MinIO alternative.
    #   Never starts with the machine: docker compose --profile seaweedfs up -d seaweedfs.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    SeaweedFS              = $false

    # Add Ollama provider (manual start)?
    #   Local LLM server on :11434, with no models pulled; CPU only.
    #   Never starts with the machine: pvup ollama.
    #   Requires: Docker set to yes (not asked, and forced to no, otherwise).
    Ollama                 = $false

    # Install Python tooling?
    #   Python (latest) via mise, plus uv, poetry, black, ruff, mypy, pytest, ipython, httpie, pre-commit.
    Python                 = $true

    # Install Node tooling?
    #   Node LTS via mise, plus pnpm, Angular CLI (Linux build), TypeScript, ESLint, Prettier.
    Node                   = $true

    # Install GitKraken?
    #   Linux GitKraken for repos on the WSL filesystem (~150 MB download).
    #   Needs WSLg (Windows 11, or Windows 10 with WSLg) to show its window.
    #   The Windows GitKraken is installed separately by setup-windows.ps1.
    GitKraken              = $true

    # Configure the keyboard layout (br / abnt2)?
    #   Fixes accents in GUI apps run through WSLg (GitKraken, ...), which ignore the Windows layout.
    #   Turn off if you do not use a Brazilian ABNT2 keyboard.
    KeyboardLayout         = $true
}
