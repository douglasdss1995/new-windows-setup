# =============================================================================
# .env — Providers (Serviços Compartilhados)
# Copie para .env e ajuste conforme necessário:
#   cp .env.example .env
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# pgAdmin — http://localhost:5050
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# MinIO (opcional, descontinuado) — S3 API and Console
# Não inicia automaticamente: docker compose --profile minio up -d minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# SeaweedFS (opcional) — S3 API, filer UI e master UI
# Não inicia automaticamente: docker compose --profile seaweedfs up -d seaweedfs
# Credenciais S3: providers/seaweedfs/s3.json (não usa variáveis de ambiente)
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333

# Portainer — http://localhost:8001
PORTAINER_HTTP_PORT=8001
PORTAINER_HTTPS_PORT=8443

# MailHog — SMTP fake + UI http://localhost:8025 (não inicia automaticamente, ver README/profiles)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Timezone
TZ=America/Manaus
