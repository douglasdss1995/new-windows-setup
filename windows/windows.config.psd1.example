# =============================================================================
# windows.config.psd1 - Windows setup configuration
#
# Only OPTIONAL tools are listed here (true = install, false = skip); `make setup`
# asks each one and saves the answer. MANDATORY tools (Chocolatey, Windows
# Terminal, PowerShell 7, Git, zoxide, fzf, VS Code, JetBrains Toolbox, mise, uv, pnpm, the CLI set,
# Gpg4win, OpenSSH, 7-Zip, VC++ Redistributables and the fonts) are always
# installed by setup-windows.ps1 and have no key. See docs/setup-windows.md.
# =============================================================================
@{

    # -------------------------------------------------------------------------
    # Git configuration (applied at the end with git config --global)
    # Leave empty "" to skip configuration
    # -------------------------------------------------------------------------
    Git              = @{
        UserName  = ""
        UserEmail = ""
    }

    # -------------------------------------------------------------------------
    # Terminal and Shell
    # -------------------------------------------------------------------------
    Terminal         = @{
        SetPowerShell7AsDefault = $true   # set PS7 as default in Windows Terminal and VS Code
        OhMyPosh                = $true
        OhMyPoshTheme           = "amro.omp.json"   # file in themes/, edit it or swap this to customize
        Starship                = $false   # alternative to OhMyPosh - pick one
    }

    # -------------------------------------------------------------------------
    # Editors and IDEs
    # -------------------------------------------------------------------------
    Editors          = @{
        Cursor = $false
    }

    # -------------------------------------------------------------------------
    # Git and Version Control
    # -------------------------------------------------------------------------
    GitTools         = @{
        GitHubCLI = $false
        GitKraken = $true
    }

    # -------------------------------------------------------------------------
    # Runtimes and Version Managers
    # -------------------------------------------------------------------------
    Runtimes         = @{
        PyenvWin   = $true   # alternative to mise for Python
        NvmWindows = $true   # alternative to mise for Node
        Python313  = $false
        NodeLTS    = $false   # managed by mise - install via: mise use -g node@lts
        Java21     = $false
    }

    # -------------------------------------------------------------------------
    # Databases
    # -------------------------------------------------------------------------
    Database         = @{
        PostgreSQL18  = $false
        DBeaver       = $true
        PgAdmin       = $true    # alternative to DBeaver for Postgres
    }

    # -------------------------------------------------------------------------
    # Infrastructure
    # -------------------------------------------------------------------------
    Infrastructure   = @{
        # Prefer IPv4 for "localhost" (netsh prefix policy) - see docs/wslconfig.md
        IPv4LoopbackPreference = $true
    }

    # -------------------------------------------------------------------------
    # API and HTTP Testing
    # -------------------------------------------------------------------------
    API              = @{
        Postman  = $true   # heavy - pick one HTTP client
        Insomnia = $false  # alternative to Postman
        Bruno    = $true   # lightweight, open-source, file-based
    }

    # -------------------------------------------------------------------------
    # Security and Authentication
    # -------------------------------------------------------------------------
    Security         = @{
        Bitwarden = $false
    }

    # -------------------------------------------------------------------------
    # Productivity
    # -------------------------------------------------------------------------
    Productivity     = @{
        Obsidian   = $true
        OBSStudio  = $false   # screen/video recording and live streaming
        Notion     = $false   # optional
        Slack      = $false   # install if used at work
        Discord    = $false   # install if used
        ShareX     = $true
        PowerToys  = $false
        Everything = $true
        WizTree    = $true    # disk usage analyzer
        AutoHotkey = $false   # optional - keyboard automation
        DrawIO     = $true    # diagram and flowchart editor (diagrams.net)
    }

    # -------------------------------------------------------------------------
    # Utilities
    # -------------------------------------------------------------------------
    Utilities        = @{
        WinRAR    = $true   # archive manager (trialware - pick one)
        VLC       = $true    # media player
        WinSCP    = $true    # SFTP/FTP client
        PuTTY     = $false    # SSH/Telnet client
        NotepadPP = $true    # text editor
    }

    # -------------------------------------------------------------------------
    # Browsers
    # -------------------------------------------------------------------------
    Browsers         = @{
        Chrome     = $true
        FirefoxDev = $true
        Opera      = $true
    }

    # -------------------------------------------------------------------------
    # VS Code Extensions
    # -------------------------------------------------------------------------
    VSCodeExtensions = @{
        # Python / Django
        Python           = $true
        Pylance          = $true
        Debugpy          = $true
        VscodeDjango     = $true
        AutoCloseTag     = $true

        # Angular / TypeScript
        NgTemplate       = $true
        TypeScriptNext   = $true
        ESLint           = $true
        Prettier         = $true

        # General
        GitLens          = $true
        GitGraph         = $true
        DockerExt        = $true
        RemoteContainers = $true
        RemoteWSL        = $true
        MaterialIcons    = $true
        IndentRainbow    = $true
        SpellChecker     = $true
    }
}
